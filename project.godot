; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="AI Game"
config/description="Top-down 3D survival extraction looter shooter. See DESIGN.md."
run/main_scene="res://ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
ItemDB="*res://scripts/autoload/item_db.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
NoiseSystem="*res://scripts/autoload/noise_system.gd"
CoverSystem="*res://scripts/autoload/cover_system.gd"
VisionSystem="*res://scripts/autoload/vision_system.gd"
Settings="*res://scripts/autoload/settings.gd"
UiSounds="*res://scripts/autoload/ui_sounds.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://ui/theme/menu_theme.tres"

